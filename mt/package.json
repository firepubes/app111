{
  "name": "ratiomail",
  "version": "1.1.0",
  "description": "RatioMail disposable email service built on Cloudflare Workers.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "deploy": "npm run build:frontend && wrangler deploy",
    "db:create": "wrangler d1 create mailtune-db",
    "db:migrate": "wrangler d1 execute mailtune-db --remote --file=src/db/schema.sql",
    "db:migrate:attachments": "wrangler d1 execute mailtune-db --remote --file=migrations/0002_attachments.sql",
    "r2:create": "wrangler r2 bucket create ratiomail-attachments",
    "admin:set-key": "wrangler secret put ADMIN_KEY"
  },
  "dependencies": {
    "hono": "^4.4.0",
    "postal-mime": "^2.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250509.0",
    "typescript": "^5.5.0",
    "wrangler": "^4.105.0"
  }
}
