{
  "name": "mailtune",
  "version": "1.0.0",
  "description": "A modern, high-performance disposable email service built on Cloudflare Workers with a premium Neobrutalism UI.",
  "type": "module",
  "author": "lrmn7",
  "repository": {
    "type": "git",
    "url": "https://github.com/lrmn7/mailtune"
  },
  "bugs": {
    "url": "https://github.com/lrmn7/mailtune/issues"
  },
  "homepage": "https://github.com/lrmn7/mailtune#readme",
  "scripts": {
    "dev": "wrangler dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "deploy": "npm run build:frontend && wrangler deploy",
    "db:create": "wrangler d1 create mailtune-db",
    "db:migrate": "wrangler d1 execute mailtune-db --remote --file=src/db/schema.sql",
    "db:local": "wrangler d1 execute mailtune-db --local --file=src/db/schema.sql"
  },
  "dependencies": {
    "hono": "^4.4.0",
    "postal-mime": "^2.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250509.0",
    "typescript": "^5.5.0",
    "wrangler": "^4.105.0"
  }
}
