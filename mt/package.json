{
  "name": "ratiomail",
  "version": "1.1.0",
  "description": "A modern disposable email service built on Cloudflare Workers with a React frontend.",
  "type": "module",
  "author": "lrmn7",
  "repository": {
    "type": "git",
    "url": "https://github.com/firepubes/app111"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "deploy": "npm run build:frontend && wrangler deploy",
    "db:create": "wrangler d1 create mailtune-db",
    "db:migrate": "wrangler d1 execute mailtune-db --remote --file=src/db/schema.sql",
    "db:migrate:attachments": "wrangler d1 execute mailtune-db --remote --file=src/db/migrations/0002_ratiomail_attachments.sql",
    "db:local": "wrangler d1 execute mailtune-db --local --file=src/db/schema.sql",
    "r2:create": "wrangler r2 bucket create ratiomail-attachments"
  },
  "dependencies": {
    "hono": "^4.4.0",
    "postal-mime": "^2.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250509.0",
    "typescript": "^5.5.0",
    "wrangler": "^4.105.0"
  }
}
